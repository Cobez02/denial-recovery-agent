# Copy to .env (git-ignored) and edit. Never commit real values; gitleaks blocks commits that look
# like they carry a secret. Settings are read from <project root>/.env whatever the current
# directory is; a variable set in the process environment wins over this file; the test suite
# ignores the file (APP_ENV=test). Every key of app.config.Settings is listed with its default.

# ---- Application ---------------------------------------------------------------------------
# local | test | docker (Docker Compose sets docker itself)
APP_ENV=local
# REQUIRED before `denial-agent serve` / docker compose up. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start with an empty, short (< 24 characters) or placeholder key
# (change-me, changeme, secret): session cookies are signed with it.
SECRET_KEY=

# ---- Storage -------------------------------------------------------------------------------
# Local zero-dependency run uses SQLite; Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./data/denial_agent.db
# DATABASE_URL=postgresql+psycopg://denial:<password>@127.0.0.1:5432/denial
# Runtime files, on the encrypted disk: uploads land under DATA_DIR/uploads/<kind>/, export
# packages under EXPORT_DIR. `purge-clinic --confirm` deletes every file in both.
DATA_DIR=./data
EXPORT_DIR=./data/exports

# ---- Jobs ----------------------------------------------------------------------------------
# inline runs imports and the pipeline synchronously (no Redis); rq uses the worker
# (python -m app.jobs.worker) on REDIS_URL. Docker Compose sets rq.
JOB_BACKEND=inline
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Model access --------------------------------------------------------------------------
# stub = offline, deterministic (tests, demos). anthropic = real calls, plain Messages API only.
# replay = recorded fixtures from LLM_REPLAY_DIR (tests).
LLM_PROVIDER=stub
# Pinned model id; run tests/test_prompt_regression.py before changing it.
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120
# Keep false: a server-side fallback would answer with a model other than the pinned one.
LLM_SERVER_FALLBACKS=false
# Only with LLM_PROVIDER=anthropic. The key must come from the HIPAA-ready organization. Either
# export it in the process environment or put it here; it is never logged.
# ANTHROPIC_API_KEY=
# Rules confidence below which the model is consulted (also for category `other` or any payer letter).
CLASSIFY_MODEL_THRESHOLD=0.75
# Let the model rewrite the appeal narrative (fact-checked; the template is kept when it fails).
MODEL_ENABLED_FOR_DRAFTING=true
# Development only: record real model output as replay fixtures. Never against real data.
LLM_RECORD=false
LLM_REPLAY_DIR=tests/fixtures/llm

# ---- Login ---------------------------------------------------------------------------------
# Keep true outside the test suite; false replaces the login with a local admin (sandbox only).
AUTH_REQUIRED=true
# true once the app is served over HTTPS (the cookie is then sent over TLS only).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Review queue and imports --------------------------------------------------------------
LOG_LEVEL=INFO
# Deadline badge thresholds in days (queue and dashboard buckets).
DEADLINE_WARN_DAYS=30,14
# Default clinic for import-claims/notes/documents and the imports page when there are several
# clinics (leave unset with one clinic).
# CLINIC_ID=1
# Windows given to a payer the first time the claims importer sees it; change a payer later with
# `denial-agent set-payer` (the importer never overwrites them).
DEFAULT_TIMELY_FILING_DAYS=90
DEFAULT_CORRECTED_CLAIM_DAYS=90
DEFAULT_APPEAL_DAYS=180

# ---- Docker Compose only -------------------------------------------------------------------
# Password of the `denial` Postgres role; `docker compose up` refuses to start without it. Letters
# and digits only (it is interpolated into DATABASE_URL). Not read by the application itself.
# POSTGRES_PASSWORD=
