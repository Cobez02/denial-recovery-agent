# Copy to .env (git-ignored). Never commit real values.

APP_ENV=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Local zero-dependency run uses SQLite; Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./data/denial_agent.db
# DATABASE_URL=postgresql+psycopg://denial:denial@127.0.0.1:5432/denial

REDIS_URL=redis://127.0.0.1:6379/0
# inline runs imports and model calls synchronously (no Redis needed); rq uses the worker container.
JOB_BACKEND=inline

# Model access. stub = offline deterministic client (tests, demos). anthropic = real calls.
# The API key must come from the HIPAA-ready organization only. Plain Messages API calls only.
LLM_PROVIDER=stub
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_SERVER_FALLBACKS=false
# ANTHROPIC_API_KEY=sk-ant-...   (keep in the OS keychain or this git-ignored file; never in code)
CLASSIFY_MODEL_THRESHOLD=0.75

AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=false

DATA_DIR=./data
EXPORT_DIR=./data/exports
LOG_LEVEL=INFO
DEADLINE_WARN_DAYS=30,14
